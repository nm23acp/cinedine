# Copy this file to .env and replace the placeholders with your own values.
# Generate a fresh Django secret key; never reuse a key that has been exposed.
DJANGO_SECRET_KEY=replace-with-a-new-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
TMDB_API_KEY=add-your-own-tmdb-api-key
